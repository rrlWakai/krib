{
  "name": "krib-beverly-place",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:ci": "npm run types:check-stale && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "types:generate": "supabase gen types typescript --local > src/types/generated/database.ts",
    "types:check-stale": "npm run types:generate && git diff --exit-code src/types/generated/",
    "env:check": "node scripts/check-env.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lenis": "^1.3.25",
    "lucide-react": "^0.487.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.2",
    "typescript": "~5.8.3",
    "vite": "^6.3.2",
    "vite-plugin-image-optimizer": "^2.0.3"
  }
}
