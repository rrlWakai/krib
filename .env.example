# ── Frontend (VITE_-prefixed, consumed by Vite build) ────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_TITLE=KRiB Beverly Place
# Public VAPID key for browser push (safe to expose in the browser)
# Generate keys: `node scripts/generate-vapid-keys.mjs`
VITE_VAPID_PUBLIC_KEY=

# ── Server-side only (never prefixed with VITE_, never in frontend bundle) ──
SUPABASE_SERVICE_ROLE_KEY=
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=KRiB

# ── Supabase Edge Function secrets (set via `supabase secrets set`, NOT here) ──
# VAPID_PUBLIC_KEY=    (JWK JSON object — safe to reference in secrets)
# VAPID_PRIVATE_KEY=   (JWK JSON object — NEVER expose to the browser)
# Generate keys: `node scripts/generate-vapid-keys.mjs`
